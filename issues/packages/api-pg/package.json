{
	"name": "@agent-issues/api-pg",
	"version": "0.1.0",
	"private": true,
	"description": "Deployable agent-issues cloud API service (stub). The JSON-RPC Postgres gate is filled in by a later slice.",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@types/express": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/supertest": "catalog:",
		"supertest": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@agent-issues/core": "workspace:*",
		"drizzle-orm": "catalog:",
		"express": "catalog:",
		"jose": "catalog:",
		"marked": "catalog:",
		"pg": "catalog:"
	}
}