{
	"name": "@agent-issues/core",
	"version": "0.1.0",
	"description": "Shared domain core for agent-issues: schema, database, and store layers.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./instruction-store": {
			"types": "./dist/features/storage-driver/instruction-store.d.ts",
			"default": "./dist/features/storage-driver/instruction-store.js"
		},
		"./storage-driver-contract": {
			"types": "./dist/features/storage-driver/storage-driver-contract.d.ts",
			"default": "./dist/features/storage-driver/storage-driver-contract.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@types/express": "catalog:",
		"@types/node": "catalog:",
		"@types/semver": "^7.8.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"drizzle-orm": "catalog:",
		"express": "catalog:",
		"fuse.js": "catalog:",
		"jose": "catalog:",
		"semver": "^7.8.5"
	}
}