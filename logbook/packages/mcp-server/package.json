{
	"name": "agent-issues-mcp",
	"version": "0.2.5",
	"description": "Stable MCP stdio proxy for the installed agent-issues CLI.",
	"type": "module",
	"bin": {
		"agent-issues-mcp": "./dist/bin/agent-issues-mcp.js"
	},
	"files": [
		"dist/bin"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node ./scripts/build.mjs",
		"postbuild": "node --eval \"import { chmodSync } from 'node:fs'; chmodSync('dist/bin/agent-issues-mcp.js', 0o755);\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"esbuild": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}