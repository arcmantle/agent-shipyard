{
	"name": "agent-issues",
	"version": "0.2.5",
	"description": "CLI for managing initiatives, PRDs, user stories, ADRs, and issues.",
	"type": "module",
	"bin": {
		"agent-issues": "./dist/cli.js",
		"agent-logbook": "./dist/cli.js",
		"alb": "./dist/cli.js"
	},
	"files": [
		"dist",
		"site/dist",
		"kanban/dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node ./scripts/build.mjs",
		"build:dev": "node ./scripts/build.mjs --development",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"validate:plugin:claude": "node ./scripts/validate-claude-plugin.mjs",
		"validate:plugin:copilot": "node ./scripts/validate-copilot-plugin.mjs"
	},
	"devDependencies": {
		"@agent-issues/api-local": "workspace:*",
		"@agent-issues/api-pg": "workspace:*",
		"@agent-issues/core": "workspace:*",
		"@azure/msal-node": "catalog:",
		"@babel/parser": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"@types/node": "catalog:",
		"clipanion": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"dependencies": {
		"@modelcontextprotocol/ext-apps": "^1.7.5",
		"better-sqlite3": "catalog:",
		"dompurify": "catalog:",
		"lit": "catalog:",
		"marked": "catalog:",
		"ora": "^8.2.0"
	}
}