{
	"id": "cli/show-human",
	"surface": "cli",
	"workspace": {
		"folder": "show-human-project"
	},
	"setup": [
		{
			"argv": [
				"create",
				"initiative",
				"--title",
				"Parity initiative",
				"--json"
			],
			"as": "initiative"
		},
		{
			"argv": [
				"create",
				"issue",
				"--title",
				"Parity issue",
				"--parent",
				"${initiative.reference}",
				"--status",
				"in-progress",
				"--json"
			],
			"as": "issue"
		}
	],
	"argv": [
		"show",
		"${issue.reference}"
	],
	"stdout": "text"
}
