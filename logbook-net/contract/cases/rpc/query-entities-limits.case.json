		{
			"method": "queryEntities",
			"params": {
				"kind": "issue",
				"limit": 0
			}
		},
		{
			"method": "queryEntities",
			"params": {
				"kind": "issue",
				"limit": 1.5
			}
		},
		{
			"method": "queryEntities",
			"params": {
				"kind": "issue",
				"limit": 5
			}
		}
	]
