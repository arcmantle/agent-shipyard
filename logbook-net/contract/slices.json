{
	"slices": [
		{
			"id": "walking-skeleton",
			"claimed": true,
			"description": "The packed tool, the Local API host with /rpc, health and discovery, the CLI with project-identity, init, schema and the minimum entity create, show and list, and MCP stdio with project_identity.",
			"surfaces": [
				"cli:schema",
				"cli:project-identity",
				"cli:init",
				"cli:create",
				"cli:show",
				"cli:list",
				"rpc:createEntity",
				"rpc:getEntityDetails",
				"rpc:getInitiativeBundle",
				"rpc:listEntities",
				"rpc:queryEntities",
				"mcp:project_identity",
				"mcp:tools/list",
				"route:POST /rpc",
				"route:GET /.well-known/agent-issues",
				"route:GET /health/live",
				"route:GET /health/ready"
			],
			"storage": [
				{
					"group": "entity lifecycle",
					"tests": [
						"creates an entity and reads it back through the async seam",
						"creates and resolves an entity by UUID or Canonical reference",
						"creation establishes revision-1 baseline with a correct content hash",
						"creates open debt with required metadata under a supported owner",
						"requires controlled debt metadata and permits it on other entity kinds",
						"requires Plans to have an initiative owner",
						"ignores caller-supplied statuses when creating a Plan",
						"rejects invalid Plan statuses and preserves supplied statuses for other kinds"
					],
					"remainder": "The other entity lifecycle tests belong to the later Port slices that port updates, relations, moves, archive, and deletion."
				},
				{
					"group": "Stable identity and Canonical reference",
					"tests": [
						"accepts a viewer short reference as a parent selector"
					],
					"remainder": "The other tests of this group belong to the later Port slice that ports reference resolution."
				},
				{
					"group": "lifecycle",
					"tests": "all"
				}
			]
		}
	],
