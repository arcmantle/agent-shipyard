{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"paths": {
			"vite": [
				"../../logbook/packages/site/node_modules/vite"
			],
			"lit": [
				"../../logbook/packages/site/node_modules/lit"
			],
			"lit/*": [
				"../../logbook/packages/site/node_modules/lit/*"
			],
			"lucide": [
				"../../logbook/packages/site/node_modules/lucide"
			]
		}
	},
	"include": [
		"*.ts",
		"components/**/*.ts"
	]
}